{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.kya-os.org/v1/protocol/audit/head-request/v1.0.0",
  "title": "KYA-OS Audit Head Request v1",
  "description": "Wire envelope of the operator-facing audit read/replay API (SPEC-AUDIT-READ), matching the @kya-os/mcp 1.16.2 runtime contract (`@kya-os/mcp/audit` read-contract).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledger"],
  "properties": {
    "schema": {
      "const": "https://schema.kya-os.org/v1/protocol/audit/head-request/v1.0.0"
    },
    "ledger": {
      "$ref": "#/$defs/ledgerRef"
    }
  },
  "$defs": {
    "ledgerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledgerId", "ledgerEpochId"],
      "description": "The ledger a read request addresses. Shared by every audit read request.",
      "properties": {
        "ledgerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "ledgerEpochId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
