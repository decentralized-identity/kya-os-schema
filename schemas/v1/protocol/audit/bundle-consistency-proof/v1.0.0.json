{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.kya-os.org/v1/protocol/audit/bundle-consistency-proof/v1.0.0",
  "title": "KYA-OS Audit Bundle Consistency Proof v1",
  "description": "Ledger-bound RFC 9162 consistency proof used as a replay-bundle component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledgerId",
    "ledgerEpochId",
    "oldCheckpointDigest",
    "newCheckpointDigest",
    "proof"
  ],
  "properties": {
    "ledgerId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ledgerEpochId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "oldCheckpointDigest": { "$ref": "#/$defs/digest" },
    "newCheckpointDigest": { "$ref": "#/$defs/digest" },
    "proof": {
      "$ref": "https://schema.kya-os.org/v1/protocol/audit/consistency-proof/v1.0.0"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
