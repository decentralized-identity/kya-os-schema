{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.kya-os.org/v1/protocol/audit/bundle-inclusion-proof/v1.0.0",
  "title": "KYA-OS Audit Bundle Inclusion Proof v1",
  "description": "Ledger-bound RFC 9162 inclusion proof used as a replay-bundle component.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledgerId",
    "ledgerEpochId",
    "sequence",
    "entryDigest",
    "checkpointDigest",
    "proof"
  ],
  "properties": {
    "ledgerId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "ledgerEpochId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sequence": { "$ref": "#/$defs/decimal" },
    "entryDigest": { "$ref": "#/$defs/digest" },
    "checkpointDigest": { "$ref": "#/$defs/digest" },
    "proof": {
      "$ref": "https://schema.kya-os.org/v1/protocol/audit/inclusion-proof/v1.0.0"
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
