{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.kya-os.org/v1/protocol/audit/list-entries-response/v1.0.0",
  "title": "KYA-OS Audit List Entries Response v1",
  "description": "Wire envelope of the operator-facing audit read/replay API (SPEC-AUDIT-READ), matching the @kya-os/mcp 1.16.2 runtime contract (`@kya-os/mcp/audit` read-contract).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries", "head", "nextAfterSequence"],
  "properties": {
    "schema": {
      "const": "https://schema.kya-os.org/v1/protocol/audit/list-entries-response/v1.0.0"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "https://schema.kya-os.org/v1/protocol/audit/signed-entry/v1.0.0"
      }
    },
    "head": {
      "oneOf": [
        {
          "$ref": "https://schema.kya-os.org/v1/protocol/audit/head-response/v1.0.0#/$defs/head"
        },
        {
          "type": "null"
        }
      ]
    },
    "nextAfterSequence": {
      "oneOf": [
        {
          "$ref": "#/$defs/decimal"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  }
}
