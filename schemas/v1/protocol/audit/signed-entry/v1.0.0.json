{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.kya-os.org/v1/protocol/audit/signed-entry/v1.0.0",
  "title": "KYA-OS Signed Audit Entry v1",
  "description": "Complete recorder-assigned audit entry envelope, matching the @kya-os/mcp v1.11.0 runtime contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["core", "eventDigest", "entryDigest", "recorderReceipt"],
  "properties": {
    "core": {
      "$ref": "https://schema.kya-os.org/v1/protocol/audit/entry/v1.0.0"
    },
    "eventDigest": { "$ref": "#/$defs/digest" },
    "entryDigest": { "$ref": "#/$defs/digest" },
    "recorderReceipt": {
      "$ref": "https://schema.kya-os.org/v1/protocol/audit/signed-receipt/v1.0.0"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
